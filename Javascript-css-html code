function validateRating() {
    const ratingInput = document.getElementById("serviceRating").value.toLowerCase();
    const feedbackElement = document.getElementById("serviceRatingFeedback");
    feedbackElement.textContent = ""; // Clear previous feedback

    // Check if ratingInput is valid
    if (ratingInput !== "poor" && ratingInput !== "good" && ratingInput !== "excellent") {
        // Provide feedback if input is invalid
        feedbackElement.textContent = "Please enter a valid rating: 'poor', 'good', or 'excellent'.";
    }
}

 function calculateTip() {
            const billAmount = parseFloat(document.getElementById("billAmount").value);
            const serviceRating = document.getElementById("serviceRating").value;
            const numberOfPeople = parseInt(document.getElementById("numberOfPeople").value);
            const feedbackElement = document.getElementById("feedback");
            const totalWithTipElement = document.getElementById("totalWithTip");
            const perPersonElement = document.getElementById("perPerson");

            // Clear previous feedback
            feedbackElement.textContent = "";

            // Validate the inputs
            if (isNaN(billAmount) || billAmount <= 0) {
                feedbackElement.textContent = "Please enter a valid bill amount.";
                return;
            }
            if (serviceRating === "") {
                feedbackElement.textContent = "Please select a service rating.";
                return;
            }

            let tipPercentage = 0;

            // Determine the tip percentage based on service rating
            switch (serviceRating) {
                case "excellent":
                    tipPercentage = 0.20;
                    break;
                case "good":
                    tipPercentage = 0.10;
                    break;
                case "poor":
                    tipPercentage = 0.00;
                    break;
            }

            // Calculate total amount and per person amount
            const tipAmount = billAmount * tipPercentage;
            const totalAmount = billAmount + tipAmount;
            const amountPerPerson = totalAmount / numberOfPeople;

            // Display results rounded to two decimal points
            totalWithTipElement.textContent = totalAmount.toFixed(2);
            perPersonElement.textContent = amountPerPerson.toFixed(2);
        }


document.addEventListener("DOMContentLoaded", function() {

    document.getElementById("moveRightBtn").addEventListener("click", function() {
        const tipulator = document.getElementById("tipulator");
        tipulator.style.transform = "translateX(500px)"; // Move right
    });

    // Move the Tipulator box back to original position
    document.getElementById("moveLeftBtn").addEventListener("click", function() {
        const tipulator = document.getElementById("tipulator");
        tipulator.style.transform = "translateX(0)"; // Move left
    });

    // Close the Tipulator box
    document.getElementById("closeBtn").addEventListener("click", function() {
        document.body.innerHTML = "<h1>Thank you for using the Tipulator</h1>";
    });
});
